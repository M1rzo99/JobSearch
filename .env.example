# @BotFather dan olingan token
BOT_TOKEN=
# Ixtiyoriy. Bo'sh qolsa, botga birinchi /start yozgan odam egasi bo'ladi.
OWNER_ID=
# Ariza usuli:
#   platform - Accept bosilganda e'lon belgilanadi va saytning 즉시지원 sahifasi tugmasi chiqadi (sayt ichidagi CV bilan o'zingiz bosasiz)
#   email    - e'londa email bo'lsa, rezyume Gmail'dan o'zi yuboriladi, bo'lmasa platform usuli
APPLY_MODE=platform
# (faqat APPLY_MODE=email uchun) Ariza yuboriladigan Gmail va uning "App password"i (Google akkaunt > Security > App passwords)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Ixtiyoriy: Saramin rasmiy API kaliti (https://oapi.saramin.co.kr). Bo'lmasa sayt sahifasidan o'qiladi.
SARAMIN_API_KEY=
# Necha daqiqada bir qidirish
SEARCH_INTERVAL_MIN=30
# Moslik balli shu qiymatdan past bo'lsa e'lon yuborilmaydi
MIN_SCORE=4
DB_PATH=data/jobs.db
